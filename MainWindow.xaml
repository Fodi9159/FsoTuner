<Window
    x:Class="FsoTuner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FsoTuner"
    Title="FSO Tuner">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: Mica shows through, caption buttons stay native. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0,140,0"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <Border
                    Width="20"
                    Height="20"
                    CornerRadius="5"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon
                        Glyph="&#xE7F8;"
                        FontSize="11"
                        Foreground="White" />
                </Border>
                <TextBlock
                    Text="FSO Tuner"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="Fullscreen Optimizations"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="980"
                Margin="32,12,32,40"
                Spacing="20"
                HorizontalAlignment="Center">

                <!-- Header -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Fullscreen Optimizations"
                            Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            Text="Choose how Windows presents fullscreen games — globally or per game."
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse
                                    x:Name="StatusDot"
                                    Width="8"
                                    Height="8"
                                    Fill="#6CCB5F"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="StatusText"
                                    Text="Checking…"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            x:Name="StatusDetail"
                            MaxWidth="340"
                            TextAlignment="Right"
                            TextWrapping="Wrap"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Success" />

                <!-- Global behavior -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock
                                    Text="Global behavior"
                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    Text="Applies to games that honor the GameConfigStore FSO values."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                x:Name="RefreshButton"
                                Grid.Column="1"
                                AutomationProperties.Name="Refresh registry values"
                                Click="RefreshButton_Click"
                                ToolTipService.ToolTip="Re-read the registry values">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="2">
                            <RadioButton
                                x:Name="DefaultRadio"
                                GroupName="FsoMode"
                                AutomationProperties.Name="Windows default — FSO allowed"
                                HorizontalContentAlignment="Stretch"
                                Checked="ModeRadio_Checked">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="Windows default — FSO allowed"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Fast Alt-Tab, overlays, HDR/VRR when FSO is applied. Games may still choose exclusive fullscreen."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                x:Name="OnRadio"
                                GroupName="FsoMode"
                                AutomationProperties.Name="FSO on — all games"
                                HorizontalContentAlignment="Stretch"
                                Checked="ModeRadio_Checked">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="FSO on — all games"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Writes the FSO-friendly preset (FSEBehavior=0, Mode=1, Honor=1, DXGI=0, EFSE=0). Games can still choose exclusive or borderless mode."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                x:Name="OffRadio"
                                GroupName="FsoMode"
                                AutomationProperties.Name="FSO off — global tweak"
                                HorizontalContentAlignment="Stretch"
                                Checked="ModeRadio_Checked">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="FSO off — global tweak"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Legacy fullscreen path. May reduce latency; can break overlays, HDR, color management, or GameDVR recording. Applies the strong preset (FSEBehavior=2, Mode=2, Honor=1, DXGI=1, EFSE=0)."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                x:Name="CustomRadio"
                                GroupName="FsoMode"
                                AutomationProperties.Name="Custom — advanced values"
                                HorizontalContentAlignment="Stretch"
                                Checked="ModeRadio_Checked">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="Custom — advanced values"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Edit the five GameConfigStore values manually."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="ApplyButton"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="Apply FSO settings"
                                Click="ApplyButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                    <TextBlock Text="Apply" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="DefaultsButton"
                                AutomationProperties.Name="Restore Windows default"
                                Click="DefaultsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                                    <TextBlock Text="Restore Windows default" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Advanced values -->
                        <StackPanel
                            x:Name="AdvancedPanel"
                            Visibility="Collapsed"
                            Spacing="12">
                            <TextBlock
                                Text="Advanced registry values"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Written as DWORDs only when Custom is selected."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Spacing="1">
                                    <TextBlock Text="GameDVR_FSEBehavior" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="0 = FSO/EFSE on, 2 = disable FSO/EFSE."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <NumberBox
                                    x:Name="FseBehaviorBox"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    AutomationProperties.Name="GameDVR FSE Behavior value"
                                    Width="120"
                                    Minimum="0"
                                    Maximum="2"
                                    SmallChange="1"
                                    Value="0"
                                    SpinButtonPlacementMode="Compact"
                                    HorizontalAlignment="Right" />

                                <StackPanel Grid.Row="1" Spacing="1">
                                    <TextBlock Text="GameDVR_FSEBehaviorMode" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="0 = high-impact games, 1 = all fullscreen, 2 = disable FSO/EFSE."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <NumberBox
                                    x:Name="FseBehaviorModeBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    AutomationProperties.Name="GameDVR FSE Behavior Mode value"
                                    Width="120"
                                    Minimum="0"
                                    Maximum="2"
                                    SmallChange="1"
                                    Value="0"
                                    SpinButtonPlacementMode="Compact"
                                    HorizontalAlignment="Right" />

                                <StackPanel Grid.Row="2" Spacing="1">
                                    <TextBlock Text="GameDVR_HonorUserFSEBehaviorMode" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="1 = honor the FSE behavior set above."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <NumberBox
                                    x:Name="HonorUserBox"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Honor user FSE behavior value"
                                    Width="120"
                                    Minimum="0"
                                    Maximum="1"
                                    SmallChange="1"
                                    Value="0"
                                    SpinButtonPlacementMode="Compact"
                                    HorizontalAlignment="Right" />

                                <StackPanel Grid.Row="3" Spacing="1">
                                    <TextBlock Text="GameDVR_DXGIHonorFSEWindowsCompatible" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="0 = FSO allowed, 1 = FSO disabled on the DXGI path."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <NumberBox
                                    x:Name="DxgiHonorBox"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    AutomationProperties.Name="DXGI honor FSE compatibility value"
                                    Width="120"
                                    Minimum="0"
                                    Maximum="1"
                                    SmallChange="1"
                                    Value="0"
                                    SpinButtonPlacementMode="Compact"
                                    HorizontalAlignment="Right" />

                                <StackPanel Grid.Row="4" Spacing="1">
                                    <TextBlock Text="GameDVR_EFSEFeatureFlags" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Bitmask for enhanced FSE features; 0 = off."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <NumberBox
                                    x:Name="EfseFlagsBox"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    AutomationProperties.Name="EFSE feature flags value"
                                    Width="120"
                                    Minimum="0"
                                    Maximum="63"
                                    SmallChange="1"
                                    Value="0"
                                    SpinButtonPlacementMode="Compact"
                                    HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <Expander
                            Header="Current registry values"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <Border
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="6"
                                Padding="12">
                                <TextBlock
                                    x:Name="RegistryValuesText"
                                    FontFamily="Cascadia Mono"
                                    FontSize="12"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="NoWrap" />
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Per-game overrides -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock
                                    Text="Per-game overrides"
                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    Text="Disables FSO only for the selected executable — the same flag as the Compatibility tab."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                x:Name="AddGameButton"
                                Grid.Column="1"
                                AutomationProperties.Name="Add game"
                                Click="AddGameButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Add game" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <InfoBar
                            x:Name="PerGameHint"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Informational"
                            Title="Global FSO is strongly off"
                            Message="Per-game FSO-disable flags are redundant while the strong global preset is active." />

                        <Border
                            x:Name="EmptyGamesPanel"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="6"
                            Padding="16">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center">
                                <FontIcon
                                    Glyph="&#xE7FC;"
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="No per-game overrides" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Add a game's .exe to disable FSO for it only."
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl
                            x:Name="GamesItems"
                            ItemsSource="{x:Bind Games, Mode=OneWay}"
                            Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:GameOverride">
                                    <Border
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid
                                        ColumnSpacing="12"
                                        Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="32"
                                            Height="32"
                                            CornerRadius="6"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            VerticalAlignment="Center">
                                            <FontIcon
                                                Glyph="&#xE7FC;"
                                                FontSize="15"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind Path}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            Width="36"
                                            Height="36"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind Path}"
                                            AutomationProperties.Name="Remove FSO override"
                                            Click="RemoveGame_Click"
                                            ToolTipService.ToolTip="Remove this override">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Text="Tip: choose the actual rendering .exe, not the launcher. Changes apply the next time the game starts."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Guidance -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Which mode should I use?"
                            Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Competitive" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="FSO off — globally or per game. Can reduce latency when a game uses exclusive fullscreen."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Single-player" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="FSO on. Fast Alt-Tab, overlays, HDR/VRR; Microsoft says performance is usually equal."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="Global changes may require signing out and back in. Per-game flags apply on the next launch."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Text="HKCU\System\GameConfigStore  ·  HKCU\Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Layers"
                            FontFamily="Cascadia Mono"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                Glyph="&#xE72E;"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="Writes only to HKCU — no administrator rights needed."
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
